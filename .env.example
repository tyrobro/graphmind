ENVIRONMENT=development

# Neo4j (Community, via Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmind_dev_password

# SQLite audit log
SQLITE_PATH=./data/graphmind.db

# Ollama (native, running on Windows host; mirrored WSL2 networking required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# Pruning tuning (Section 8 of the PRD)
MEMORY_PRESSURE_THRESHOLD=0.80
ALPHA=0.5
BETA=0.5
MIN_NODE_AGE_SECONDS=300
PRUNE_UNDO_WINDOW_HOURS=24
EDGE_DECAY_FACTOR=0.7